{
  "name": "@adhar-ui/angular",
  "version": "0.1.1",
  "description": "Angular components compiled from Mitosis",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": "./src/generated/src/components/*"
  },
  "files": [
    "dist",
    "src/generated",
    "README.md"
  ],
  "keywords": [
    "design-system",
    "adhar-ui",
    "components",
    "tailwind"
  ],
  "author": "Adhar",
  "license": "Apache-2.0",
  "dependencies": {
    "@adhar-ui/utils": "^0.1.1",
    "class-variance-authority": "^0.7.1"
  },
  "peerDependencies": {
    "@angular/core": "^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/common": "^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adhar-io/adhar-ui",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.js"
}
