{
  "name": "@adhar-ui/tokens",
  "version": "0.1.1",
  "description": "Design tokens for the Adhar UI design system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presets/*": {
      "types": "./dist/presets/*.d.ts",
      "import": "./dist/presets/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "design-tokens",
    "css-variables",
    "tailwind",
    "design-system",
    "adhar-ui"
  ],
  "author": "Adhar",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/adhar-io/adhar-ui",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.js"
}
