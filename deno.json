{
  "nodeModulesDir": "auto",
  "workspace": [
    "./packages/tokens",
    "./packages/tailwind-preset",
    "./packages/utils",
    "./packages/a11y",
    "./packages/icons",
    "./packages/primitives",
    "./packages/react",
    "./packages/vue",
    "./packages/solid",
    "./packages/svelte",
    "./packages/angular",
    "./packages/cli",
    "./packages/registry",
    "./packages/dtcg",
    "./packages/design-sync",
    "./packages/figma-plugin",
    "./packages/penpot-plugin",
    "./packages/sync-server",
    "./packages/code-connect",
    "./apps/docs",
    "./apps/storybook"
  ],
  "tasks": {
    "build": "deno task build:tokens && deno task build:utils && deno task build:a11y && deno task build:icons && deno task build:tailwind-preset && deno task build:primitives && deno task build:angular && deno task build:cli && deno task build:design-sync && deno task build:dtcg && deno task build:react && deno task build:registry && deno task build:solid && deno task build:svelte && deno task build:vue",
    "build:tokens": "cd packages/tokens && deno task build",
    "build:tailwind": "cd packages/tailwind-preset && deno task build",
    "build:utils": "cd packages/utils && deno task build",
    "build:a11y": "cd packages/a11y && deno task build",
    "build:icons": "cd packages/icons && deno task build",
    "build:primitives": "cd packages/primitives && deno task build",
    "check": "deno check packages/*/src/index.ts",
    "test": "deno test packages/*/src/__tests__/ --allow-read --allow-env --allow-net",
    "lint": "deno lint packages/",
    "fmt": "deno fmt",
    "clean": "rm -rf packages/*/dist",
    "cli": "deno run -A packages/cli/src/index.ts",
    "docs:dev": "cd apps/docs && deno task dev",
    "storybook:dev": "cd apps/storybook && deno task dev",
    "build:tailwind-preset": "cd packages/tailwind-preset && deno task build",
    "build:angular": "cd packages/angular && deno task build",
    "build:cli": "cd packages/cli && deno task build",
    "build:design-sync": "cd packages/design-sync && deno task build",
    "build:dtcg": "cd packages/dtcg && deno task build",
    "build:react": "cd packages/react && deno task build",
    "build:registry": "cd packages/registry && deno task build",
    "build:solid": "cd packages/solid && deno task build",
    "build:svelte": "cd packages/svelte && deno task build",
    "build:vue": "cd packages/vue && deno task build"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": [
      "packages/*/src/generated/",
      "packages/cli/src/templates/",
      "apps/",
      "packages/*/dist/",
      "dist/"
    ]
  },
  "lint": {
    "include": [
      "packages/"
    ],
    "exclude": [
      "packages/*/src/generated/",
      "packages/cli/src/templates/",
      "packages/*/dist/",
      "dist/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@adhar-ui/tokens": "./packages/tokens/src/index.ts",
    "@adhar-ui/tailwind-preset": "./packages/tailwind-preset/src/index.ts",
    "@adhar-ui/utils": "./packages/utils/src/index.ts",
    "@adhar-ui/a11y": "./packages/a11y/src/index.ts",
    "@adhar-ui/icons": "./packages/icons/src/index.ts",
    "@adhar-ui/primitives": "./packages/primitives/src/index.ts",
    "@adhar-ui/registry": "./packages/registry/src/index.ts",
    "@adhar-ui/dtcg": "./packages/dtcg/src/index.ts",
    "@adhar-ui/design-sync": "./packages/design-sync/src/index.ts",
    "@adhar-ui/design-sync/generator": "./packages/design-sync/src/generator/index.ts",
    "tsup": "npm:tsup@^8.5.1",
    "typescript": "npm:typescript@^5.7.0",
    "clsx": "npm:clsx@^2.1.1",
    "tailwind-merge": "npm:tailwind-merge@^3.5.0",
    "class-variance-authority": "npm:class-variance-authority@0.7.1",
    "react": "npm:react@^19.2.0"
  }
}
