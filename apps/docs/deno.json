{
  "tasks": {
    "dev": "deno run -A npm:vite@^8.0.0 --host",
    "build": "deno run -A npm:vite@^8.0.0 build",
    "preview": "deno run -A npm:vite@^8.0.0 preview"
  },
  "imports": {
    "react": "npm:react@^19.2.0",
    "react-dom": "npm:react-dom@^19.2.0",
    "react/jsx-runtime": "npm:react@^19.2.0/jsx-runtime",
    "@monaco-editor/react": "npm:@monaco-editor/react@^4.7.0",
    "tailwindcss": "npm:tailwindcss@^4.1.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ]
  }
}
